# Ghostty config generated by Dotter.

theme = custom

font-family = SauceCodePro Nerd Font
font-family = LXGW WenKai Mono Lite
{{#if dotter.macos}}
font-family = PingFang SC
{{else if dotter.linux}}
font-family = Noto Sans CJK SC
{{/if}}
font-style = Normal
{{#if dotter.macos}}
font-size = 18
{{else if dotter.linux}}
font-size = 13
{{/if}}

scrollbar = never
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false

cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

copy-on-select = false
right-click-action = paste

background-image = backdrops/pastel-samurai.acrylic.png
background-image-fit = cover
background-image-position = center
background-image-repeat = false

confirm-close-surface = false

# Bare Alt navigation is encoded by Ghostty and handled by tmux.
# Clipboard shortcuts use the platform modifier; terminal tabs add Shift.
{{#if dotter.macos}}
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = shift+super+t=new_tab
keybind = shift+super+w=close_tab
keybind = shift+super+,=previous_tab
keybind = shift+super+.=next_tab

# Send Command navigation as CSI-u Meta keys for tmux.
# M-h
keybind = super+h=unbind
keybind = super+h=csi:104;3u
# M-j
keybind = super+j=unbind
keybind = super+j=csi:106;3u
# M-k
keybind = super+k=unbind
keybind = super+k=csi:107;3u
# M-l
keybind = super+l=unbind
keybind = super+l=csi:108;3u
# M-,
keybind = super+,=unbind
keybind = super+,=csi:44;3u
# M-.
keybind = super+.=unbind
keybind = super+.=csi:46;3u
# M-[
keybind = super+[=unbind
keybind = super+[=csi:91;3u
# M-]
keybind = super+]=unbind
keybind = super+]=csi:93;3u
# M-t
keybind = super+t=unbind
keybind = super+t=csi:116;3u
# M-w
keybind = super+w=unbind
keybind = super+w=csi:119;3u
{{else if dotter.linux}}
keybind = alt+c=copy_to_clipboard
keybind = alt+v=paste_from_clipboard
keybind = shift+alt+t=new_tab
keybind = shift+alt+w=close_tab
keybind = shift+alt+,=previous_tab
keybind = shift+alt+.=next_tab
{{/if}}

keybind = f11=toggle_fullscreen
keybind = ctrl+n=new_window
